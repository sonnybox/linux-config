#!/bin/fish

cd ~/git/Kokoro-FastAPI/
source .venv/bin/activate.fish

function ask_cpu_or_gpu
    while true
        read -P "Choose CPU or GPU (1/2): " choice
        switch $choice
            case 1
                echo "cpu"
                return
            case 2
                echo "gpu"
                return
            case '*'
                echo "Invalid choice. Please enter 1 for CPU or 2 for GPU."
        end
    end
end

set choice (ask_cpu_or_gpu)

if test $choice = "cpu"
    ./start-cpu.sh
else if test $choice = "gpu"
    ./start-gpu.sh
end

